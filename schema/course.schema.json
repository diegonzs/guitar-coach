{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "goal": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": [
        "title"
      ]
    },
    "units": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "description": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "id",
          "title",
          "level"
        ]
      }
    },
    "dailyRoutine": {
      "default": [
        {
          "kind": "tuner",
          "title": "Afinar y calentar",
          "minutes": 5
        },
        {
          "kind": "lesson",
          "title": "Lección del día",
          "minutes": 15
        },
        {
          "kind": "free",
          "title": "Toca lo que quieras",
          "minutes": 10
        }
      ],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "tuner",
              "lesson",
              "free",
              "review"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          }
        },
        "required": [
          "kind",
          "title",
          "minutes"
        ]
      }
    }
  },
  "required": [
    "title",
    "units"
  ],
  "title": "course.yaml"
}
