{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "assessment"
    },
    "formatVersion": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "maxLength": 400
    },
    "questions": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "options": {
            "minItems": 2,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "multiple": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "text",
          "options"
        ]
      }
    },
    "stopAfterFailures": {
      "default": 2,
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "exercises": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "instructions": {
            "description": "Indicación corta que se muestra mientras se practica",
            "type": "string",
            "maxLength": 2000
          },
          "fingering": {
            "description": "Digitación de la mano derecha, un símbolo por golpe (p i m a c, acordes con +, \"-\" sin indicar). Si es más corta que el ejercicio, se repite.",
            "type": "string"
          },
          "tempo": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 20,
                "maximum": 300,
                "description": "BPM con el que se empieza"
              },
              "target": {
                "description": "BPM objetivo; al alcanzarlo el ejercicio se considera dominado",
                "type": "integer",
                "minimum": 20,
                "maximum": 300
              },
              "step": {
                "default": 5,
                "description": "Cuántos BPM se suben cada vez que se desbloquea el siguiente tempo",
                "type": "integer",
                "minimum": 1,
                "maximum": 40
              }
            },
            "required": [
              "start"
            ]
          },
          "beatUnit": {
            "default": 4,
            "description": "Qué figura cuenta como un pulso del metrónomo",
            "anyOf": [
              {
                "type": "number",
                "const": 4
              },
              {
                "type": "number",
                "const": 8
              }
            ]
          },
          "cleanRepsToAdvance": {
            "default": 8,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "timingToleranceMs": {
            "default": 70,
            "type": "integer",
            "minimum": 20,
            "maximum": 250
          },
          "checks": {
            "default": [
              "notes",
              "timing"
            ],
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "notes",
                "timing",
                "posture.rightWrist",
                "posture.leftWrist",
                "posture.leftThumb",
                "posture.shoulders"
              ]
            }
          },
          "loop": {
            "default": true,
            "type": "boolean"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Nivel que demuestra quien supera esta prueba"
          },
          "skill": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "Habilidad que mide (ritmo, arpegio, melodía, cejilla…)"
          },
          "reps": {
            "default": 2,
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "pass": {
            "default": {},
            "type": "object",
            "properties": {
              "accuracy": {
                "default": 0.8,
                "description": "Proporción mínima de notas correctas",
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "timingMs": {
                "default": 70,
                "description": "Desviación media máxima en ms",
                "type": "integer",
                "minimum": 10,
                "maximum": 300
              }
            }
          }
        },
        "required": [
          "id",
          "title",
          "tempo",
          "level",
          "skill"
        ]
      }
    }
  },
  "required": [
    "type",
    "id",
    "title",
    "exercises"
  ],
  "title": "Frontmatter de la evaluación (assessment.md)"
}
